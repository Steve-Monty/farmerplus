# Local test environment. Never commit the real .env file.
FARMER_ENVIRONMENT=development
FARMER_DATA_DIR=./data
FARMER_PUBLIC_URL=http://127.0.0.1:8088
FARMER_PWA_PUBLIC_URL=http://127.0.0.1:5173
FARMER_SECURE_COOKIES=0
FARMER_TENANCY_ENABLED=1

# SMTP2GO EU account. The password must be an SMTP User password, not the
# SMTP2GO dashboard account password.
SMTP2GO_HOST=mail-eu.smtp2go.com
SMTP2GO_PORT=587
SMTP2GO_USERNAME=steve@informationcapital.co.za
SMTP2GO_PASSWORD=
SMTP_FROM_EMAIL=noreply@farmerplus.earth
SMTP_FROM_NAME=FarmerPlus

# Testing only. Startup rejects this mode when FARMER_ENVIRONMENT=production.
TEST_EMAIL_MODE=true
TEST_EMAIL_RECIPIENT=steve@informationcapital.co.za

# Optional upstream social providers. Leave each pair empty until credentials
# and exact redirect URIs have been created at that provider.
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
APPLE_OIDC_CLIENT_ID=
APPLE_OIDC_CLIENT_SECRET=
FARMER_OAUTH_SESSION_SECRET=

# Separate FarmerPlus Keycloak realm. Follow identity/keycloak/README.md.
# Leave issuer empty until the realm, clients and secrets are provisioned.
FARMER_IDENTITY_PROVIDER=keycloak
FARMER_OIDC_ISSUER=
FARMER_OIDC_STORAGE_KEY=
FARMER_WEB_CLIENT_ID=farmerplus-pwa
# Optional exact loopback client approved for Moodle Learning introspection only.
FARMER_PREVIEW_LEARNING_CLIENT_ID=
FARMER_WEB_CLIENT_SECRET=
FARMER_KEYCLOAK_ADMIN_CLIENT_ID=farmerplus-provisioner
FARMER_KEYCLOAK_ADMIN_CLIENT_SECRET=
FARMER_KEYCLOAK_LOOPBACK=0
FARMER_KEYCLOAK_GOOGLE_ENABLED=0
FARMER_KEYCLOAK_APPLE_ENABLED=0
FARMER_LEARNING_ORIGIN=
FARMER_LEARNING_CLIENT_ID=farmerplus-learning
FARMER_LEARNING_CLIENT_SECRET=
FARMER_LEARNING_INTROSPECTION_SECRET=
FARMER_LEARNING_PROVISIONING_SECRET=
# Operator-only broker configuration/Apple rotation. Not the provisioner client.
FARMER_KEYCLOAK_BROKER_ADMIN_CLIENT_ID=
FARMER_KEYCLOAK_BROKER_ADMIN_CLIENT_SECRET=
FARMER_APPLE_TEAM_ID=
FARMER_APPLE_KEY_ID=
FARMER_APPLE_SERVICES_ID=
FARMER_APPLE_PRIVATE_KEY_FILE=
## Independent backend administrator login; provision through the server CLI.
FARMER_ADMIN_LOCAL_LOGIN=0
